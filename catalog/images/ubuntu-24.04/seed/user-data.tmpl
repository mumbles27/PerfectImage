#cloud-config
# Ubuntu autoinstall answers. PerfectImage renders this Go template into the
# "cidata" seed ISO attached to the build VM (cloud-init NoCloud datasource).
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: Etc/UTC
  storage:
    layout:
      name: direct
  ssh:
    install-server: true
    allow-pw: true
  packages:
    - qemu-guest-agent
    - cloud-init
    - openssh-server
    - sudo
  updates: security
  late-commands:
    - curtin in-target -- systemctl enable qemu-guest-agent
  user-data:
    disable_root: true
    users:
      - name: {{ .Username }}
        groups: [sudo]
        shell: /bin/bash
        sudo: ALL=(ALL) NOPASSWD:ALL
        lock_passwd: false
        plain_text_passwd: {{ json .Password }}
