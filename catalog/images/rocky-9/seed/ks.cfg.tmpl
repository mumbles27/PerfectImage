# Rocky Linux 9 kickstart. PerfectImage renders this Go template into the
# "OEMDRV" seed ISO attached to the build VM (inst.ks=hd:LABEL=OEMDRV:/ks.cfg).
text
reboot
eula --agreed
lang en_US.UTF-8
keyboard us
timezone UTC --utc
firstboot --disable
selinux --enforcing
firewall --enabled --ssh

# The boot ISO carries no packages, so install from the public mirror network.
url --url="https://download.rockylinux.org/pub/rocky/9/BaseOS/x86_64/os/"
repo --name="AppStream" --baseurl="https://download.rockylinux.org/pub/rocky/9/AppStream/x86_64/os/"

network --bootproto=dhcp --device=link --activate --hostname=rocky9.local

# Root locked; one build user in wheel with a temporary password.
rootpw --lock
user --name={{ .Username }} --password={{ .Password }} --plaintext --groups=wheel

zerombr
clearpart --all --initlabel
autopart --type=plain
bootloader --location=mbr

%packages
@^minimal-environment
qemu-guest-agent
cloud-init
cloud-utils-growpart
openssh-server
sudo
%end

%post --erroronfail
# Passwordless sudo for the build user during the build only; cleanup.sh removes it.
echo '{{ .Username }} ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/99-pi-build
chmod 0440 /etc/sudoers.d/99-pi-build
systemctl enable qemu-guest-agent sshd
%end
